{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/easy-mat-ui",
  "lib": {
    "entryFile": "src/public-api.ts",
    "styleIncludePaths": [
      "../../node_modules",
      "src/lib/styles"
    ]
  },
  "assets": [
    {
      "glob": "styles.scss",
      "input": "src/lib",
      "output": "styles"
    },
    {
      "glob": "styles/**/*.scss",
      "input": "src/lib",
      "output": "styles"
    }
  ],
  "allowedNonPeerDependencies": [
    "bootstrap"
  ]
}
